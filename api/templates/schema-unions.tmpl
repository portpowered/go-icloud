        // validate{{$typeName}} checks the generated oneOf contract without rewriting bytes.
        func validate{{$typeName}}(data []byte) error {
            var object map[string]interface{}
            if err := json.Unmarshal(data, &object); err != nil { return err }
            if object == nil { return errors.New("{{$typeName}} requires an object") }
            matches := 0
            {{range $index, $reference := $schema.OAPISchema.OneOf -}}
                if matches{{$typeName}}Member{{$index}}(object) { matches++ }
            {{end -}}
            if matches != 1 { return errors.New("{{$typeName}} requires exactly one schema member") }
            return nil
        }
        {{range $index, $reference := $schema.OAPISchema.OneOf -}}
            {{$member := $reference.Value -}}
            func matches{{$typeName}}Member{{$index}}(object map[string]interface{}) bool {
                {{range $member.Required -}}
                    if _, present := object[{{printf "%q" .}}]; !present { return false }
                {{end -}}
                {{range $name, $reference := $member.Properties -}}
                    if value, present := object[{{printf "%q" $name}}]; present {
                        {{if $reference.Value.Nullable -}} if value != nil { {{end -}}
                        {{if $reference.Value.Type.Is "string" -}}
                            if _, valid := value.(string); !valid { return false }
                        {{else -}}
                            if _, valid := value.(bool); !valid { return false }
                        {{end -}}
                        {{if $reference.Value.Nullable -}} } {{end -}}
                    }
                {{end -}}
